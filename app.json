{
  "expo": {
    "name": "Ghostcar",
    "slug": "Ghostcar",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/ghostcar-app-icon.png",
    "scheme": "ghostcar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/ghostcar-app-icon.png"
    },
    "android": {
      "package": "com.ghostcarbr.ghostcar",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#00102D",
        "foregroundImage": "./assets/images/ghostcar-app-icon.png",
        "monochromeImage": "./assets/images/ghostcar-app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ghostcar-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00102D",
          "android": {
            "image": "./assets/images/ghostcar-app-icon.png",
            "imageWidth": 160
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "82a07d78-84b2-44ae-b400-5a4f124d642b"
      }
    },
    "owner": "ghostcarbr"
  }
}
